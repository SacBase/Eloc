use StdIO: all;

use Array: all except {++};
import Array: {++};

use Numerical: {log, exp};
import Numerical: {cosh};

use FileSystem: all;
use RuntimeError: all;
use Benchmarking: all;
use RTimer: all;
use CommandLine: all;
use Xoshiro: {xoshiro128p, srand128};
use File: {File};
use SysErr: {fail, clear};
use String: { strcat, tos, string, sscanf, strtod, strtoi, strstr, strdrop, strtok};

// #define M 512
// #define N 256

// Missing Stdlib functions:

inline
float[d:shp] cosh(float[d:shp] a) {
	return {iv -> cosh(a[iv]) | iv < shp};
}

inline
double[d:shp] cosh(double[d:shp] a) {
	return {iv -> cosh(a[iv]) | iv < shp};
}

inline
string ++ (string a, string b) {
	return strcat(a, b);
}

inline 
int[r, d:n] oConcat (int[q, d:n] a, int[p, d:n] b) | (r == q + p){
	return {[i] -> a[i]   |        [i] < [q];
			[i] -> b[i-q] | [q] <= [i] < [q+p]};
}

// Command line functions:
int, int, int, double, int, string
get_cl_args() {
	args = argv();
	i = strstr(args, " ");
	args = strdrop(args, i);
	Lx, args = strtoi(args, 10);
	Ly, args = strtoi(args, 10);
	alpha, args = strtoi(args, 10);
	gamma, args = strtod(args);
	runs, args = strtoi(args, 10);
	seed, args = strtoi(args, 10);
	
	id = "";

	i = strstr(args, "-id ");
	if (i != -1) {
		args = strdrop(args, i+4);
		args = args ++ " ";
		id, args = strtok(args, " ");
	}

	return (Lx, Ly, alpha, gamma, runs, id);
}

// File handling functions:

File open_file_w(string filename) {
	exists, _ = access(filename, 0);
	can_write, _ = access(filename, 2);

	if (exists && !can_write) {
		error(-1, "File " ++ filename ++ " could not be written to.");
	}

	_, f = fopen(filename, "w");

	return f;
}

File open_file_r(string filename) {
	has_access, _ = access(filename, 1);

	if (!has_access) {
		error(-1, "File " ++ filename ++ " could not be opened.");
	}

	_, f = fopen(filename, "r");

	return f;
}

double[d:shp] scan_double(File f, int[d] shp)
{
	ret_arr = genarray([prod(shp)], 0.0);

	_, tmp = fscanfloat(f);
	ret_arr[0] = tod(tmp);

	for (i = 1; i < prod(shp); i++) {
		if (feof(f)) {
			error(-1, "Reached end of file\n");
		}
		_, _ = fscanchar(f);
		_, tmp = fscanfloat(f);
		ret_arr[i] = tod(tmp);
	}

	return reshape(shp, ret_arr);
}

inline
void write_results(File file, double[runs] results) {
	for (i = 0; i < runs; i++) {
		fprintf(file, "%f\n", results[i]);
	}

	return;
}

// Random state generation functions:

double[N,nspins] genRandomState (int[2] shp) | all(shp > 0) {
	iS = srand128();
	states = genarray(shp, 0.0);

	for (i = 0; i < shp[0]; i++) {
		for (j = 0; j < shp[1]; j++) {
			ui, iS = xoshiro128p(iS);
			states[i,j] = tod((abs(toi(ui)) % 2) * 2 - 1);
		}
	}

	return states;
}

// Bond generation functions:

int getIndex(int x, int y, int Lx) {
	return y * Lx + x;
}

inline
int[k, 2] square_lattice_bonds(int Lx, int Ly) | (k == Lx * Ly * 2) {

	bonds_x = {[y,x] -> [getIndex(x, y, Lx), getIndex((x + 1) % Lx, y, Lx)] | [y,x] < [Ly,Lx]};
	bonds_y = {[y,x] -> [getIndex(x, y, Lx), getIndex(x, (y + 1) % Ly, Lx)] | [y,x] < [Ly,Lx]};

	return reshape([Lx*Ly*2, 2], oConcat(bonds_x, bonds_y));
}

/*******************************************************************************
 *
 * The computational functions:
 *
 ******************************************************************************/
inline
double[M] theta (double[N] s, double[M, N] tp_W, double[M] b)
{
    return { [h] -> b[h] + sum (tp_W[h] * s) };
}

inline
double logpsi (double[M] theta, double gamma)
{
    return gamma * sum (log (2.0 * cosh (theta)));
}

inline
double
elocUpdate (int i, int j, double[N] s, double[M] theta,
            double logpsi_s, double [N, M] W, double gamma)
{
    eloc = s[i] * s[j];
    if (s[i] != s[j]) {
        theta_p = { [h] -> theta[h] - 2.0*W[i,h]*s[i] - 2.0*W[j,h]*s[j] };
        logpsi_sp = logpsi (theta_p, gamma);
        eloc -= 2.0 * exp (logpsi_sp  - logpsi_s);
    }
    return eloc;
}

double
eloc_lookup_table(double[N] s, int[M, 2] bonds, double[N, M] W, double[M] b, double gamma)
{
    theta = theta (s, transpose(W), b);
    logpsi_s = logpsi (theta, gamma);
    return sum ({ [k] -> elocUpdate (bonds[k,0], bonds[k,1], s, theta, logpsi_s, W, gamma) });
}

/*******************************************************************************
 *
 * The main:
 *
 ******************************************************************************/

int main() {
	Lx, Ly, alpha, gamma, runs, id = get_cl_args();
	
	N = Lx * Ly;
	M = N * alpha;

	w_filename = "data/weights/weights_" ++ tos(N) ++ "_" ++ tos(alpha) ++ "_ti_J.csv";
	w_file = open_file_r(w_filename);
	w = scan_double(w_file, [N, M]);

	b_filename = "data/weights/weights_" ++ tos(N) ++ "_" ++ tos(alpha) ++ "_ti_h.csv";
	b_file = open_file_r(b_filename);
	b = scan_double(b_file, [M]);

	bonds = square_lattice_bonds(Lx, Ly);

	s_filename = "data/states/states_" ++ tos(runs) ++ "x" ++ tos(N) ++ ".csv";
	s_file = open_file_r(s_filename);
	states = scan_double(s_file, [runs, N]);

	timer = createRTimer();
	rts = genarray([runs], 0.0);
	tots = 0.0;
	

	for (i = 0; i < runs; i++) {
		resetRTimer(timer);
		startRTimer(timer);
		E_loc = eloc_lookup_table(states[i], bonds, w, b, gamma) / tod(N * 4);
        tots += E_loc;
		stopRTimer(timer);
		rt = getRTimerDbl(timer);
		rts[i] = rt;
		printf("run=%d  eloc=%.6f (%.3f ms) \n", i, E_loc, rt * 1e3);
	}

	destroyRTimer(timer);
	printf("total runtime:   %.6f seconds\n", sum(rts));
	printf("average runtime: %f\n", sum(rts) / tod(runs));
    printf("summed eloc:     %f\n", tod( tots));

	r_filename = "results/sac" ++ id ++ "_" ++ tos(N) ++ ".csv";
	r_file = open_file_w(r_filename);
	write_results(r_file, rts);
	
	return 0;
}
