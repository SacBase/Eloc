use StdIO: all;

use Array: all except {++};
import Array: {++};

use Numerical: {log, exp};
import Numerical: {cosh};

use FileSystem: all;
use RuntimeError: all;
use Benchmarking: all;
use RTimer: all;
use Xoshiro: {xoshiro128p, srand128};
use File: {File};
use SysErr: {fail, clear};
use String: { strcat, tos, string};

// Missing Stdlib functions:

inline
float[d:shp] cosh(float[d:shp] a) {
	return {iv -> cosh(a[iv]) | iv < shp};
}

inline
double[d:shp] cosh(double[d:shp] a) {
	return {iv -> cosh(a[iv]) | iv < shp};
}

inline
string ++ (string a, string b) {
	return strcat(a, b);
}

inline 
int[r, d:n] oConcat (int[q, d:n] a, int[p, d:n] b) | (r == q + p){
	return {[i] -> a[i]   |        [i] < [q];
			[i] -> b[i-q] | [q] <= [i] < [q+p]};
}

// File handling functions:

File open_file_r(string filename) {
	has_access, _ = access(filename, 1);

	if (!has_access) {
		error(-1, "File " ++ filename ++ " could not be opened.");
	}

	_, f = fopen(filename, "r");

	return f;
}

double[n], File scan_doubles(File f, int n) {
	ret_arr = genarray([n], 0.0);
	b = true;
	for (i = 0; i < n; i++) {
		do {
			if (feof(f)) {
				error(-1, "Reached end of file.\n");
			}

			if (!b) {
				_, _ = fscanchar(f);
			}

			b, tmp = fscanfloat(f);
		} while (!b);

		ret_arr[i] = tod(tmp);
	}
	return (ret_arr, f);
}

File skipline(File f) {
	do {
		_, c = fscanchar(f);
	}
	while (c != '\n');
	return f;
}

double[n, m] read_states_2d(File file, int[2] shp) {
	arr = genarray(shp, 0.0);
	for (i = 1; i < shp[0]; i++) {
		_, f = fscanfloat(file);
		arr[i,0] = tod(f);
		for (j = 1; j < shp[1]; j++) {
			_, _ = fscanchar(file);
			_, f = fscanfloat(file);
			arr[i,j] = tod(f);
		}
		file = skipline(file);
	}

	return arr;
}

double[m] read_states_1d(File file, int n) {
	arr = genarray([n], 0.0);
	_, f = fscanfloat(file);
	arr[0] = tod(f);
	for (i = 1; i < n; i++) {
		file = skipline(file);
		_, f = fscanfloat(file);
		arr[i] = tod(f);
	}

	return arr;
}

double[m, n] scan_w(File f, int start_row, int end_row, int start_col, int end_col)
                 | (m == end_row - start_row && n == end_col - start_col)
{
	ret_arr = genarray([end_row - start_row, end_col - start_col], 0.0);

	for (j = 0; j < start_row; j++) {
		f = skipline(f);
	}

	for (i = 0; i < end_row-start_row; i++) {
		_,   f = scan_doubles(f, start_col);
		tmp, f = scan_doubles(f, end_col-start_col);
		ret_arr[i] = tmp;
		f = skipline(f);
	}
	return ret_arr;
}

// Random state generation functions:

double[N,nspins] genRandomState (int[2] shp) | all(shp > 0) {
	iS = srand128();
	states = genarray(shp, 0.0);

	for (i = 0; i < shp[0]; i++) {
		for (j = 0; j < shp[1]; j++) {
			ui, iS = xoshiro128p(iS);
			states[i,j] = tod((abs(toi(ui)) % 2) * 2 - 1);
		}
	}

	return states;
}

// Bond generation functions:

int getIndex(int x, int y, int Lx) {
	return y * Lx + x;
}

inline
int[k, 2] square_lattice_bonds(int Lx, int Ly) | (k == Lx * Ly * 2) {

	bonds_x = {[y,x] -> [getIndex(x, y, Lx), getIndex((x + 1) % Lx, y, Lx)] | [y,x] < [Ly,Lx]};
	bonds_y = {[y,x] -> [getIndex(x, y, Lx), getIndex(x, (y + 1) % Ly, Lx)] | [y,x] < [Ly,Lx]};

	return reshape([Lx*Ly*2, 2], oConcat(bonds_x, bonds_y));
}

// The computational functions:

inline
double energy (double[M] activation, double gamma)
{
    return gamma * sum (log (activation));
}

inline
double[M] activation (double[M] weightedSum)
{
    return 2.0 * cosh(weightedSum);
}

inline
double scalarProduct (double[n] a, double[n] b)
{
    return sum (a * b);
}


inline
double, double[M]
logpsi(double[N] s, double[M, N] tp_W, double[M] b, double gamma) 
{
	theta = {[h] -> scalarProduct(tp_W[h], s) | [h] < [M]} + b;
	activation = activation(theta);
	logpsi_s = energy(activation, gamma);

	return (logpsi_s, theta);
}

inline
double
energyAdjustment(double[N] s, int i, int j, double[M] theta, double [N, M] W, double[M] b, double logpsi_s, double gamma) {
	E_loc = s[i] * s[j];

	if (s[i] != s[j]) {
		delta_theta = {[h] -> 2.0 * W[i, h] * s[i] + 2.0 * W[j, h] * s[j] | [h] < [M]};
		theta_prime = theta - delta_theta;
		activation_prime = activation(theta_prime);
		logpsi_s_prime = energy(activation_prime, gamma);
		E_loc -= 2.0 * exp(logpsi_s_prime - logpsi_s);
	}
	return E_loc;
}

double eloc_lookup_table(double[N] s, int[M, 2] bonds, double [N, M] W, double[M] b, double gamma) {
	logpsi_s, theta = logpsi(s, transpose(W), b, gamma);

	return sum({ [k] -> energyAdjustment(s, bonds[k][0], bonds[k][1], theta, W, b, logpsi_s, gamma) | [k] < [M] });
}

int main() {
	Lx = 16;
	Ly = 16;
	N = Lx * Ly;
	alpha = 2;
	gamma = 0.5;

	M = N * alpha;
	runs = 1000;

	w_filename = "data/weights/Ising_" ++ tos(N) ++ "_" ++ tos(alpha) ++ "_ti_J.csv";
	w_file = open_file_r(w_filename);
	w = scan_w(w_file, M, M + N, 0, M);

	b_filename = "data/weights/Ising_" ++ tos(N) ++ "_" ++ tos(alpha) ++ "_ti_h.csv";
	b_file = open_file_r(b_filename);
	b, _ = scan_doubles(b_file, M);

	bonds = square_lattice_bonds(Lx, Ly);


	s_filename = "data/states/states_" ++ tos(runs) ++ "x" ++ tos(N) ++ ".csv";
	s_file = open_file_r(s_filename);
	states = read_states_2d(s_file, [runs, N]);

	timer = createRTimer();
	total_time = 0.0;
	tots = 0.0;
	

	for (i = 0; i < runs; i++) {
		resetRTimer(timer);
		startRTimer(timer);
		E_loc = eloc_lookup_table(states[i], bonds, w, b, gamma) / tod(N * 4);
        tots += E_loc;
		stopRTimer(timer);
		rt = getRTimerDbl(timer);
		total_time += rt;
	}

	destroyRTimer(timer);
	printf("total runtime: " ++ tos(total_time) ++ "\n");
	printf("average runtime: " ++ tos(total_time / tod(runs)) ++ "\n");
    printf(" tots: %f\n", tod( tots));

	return 0;
}
